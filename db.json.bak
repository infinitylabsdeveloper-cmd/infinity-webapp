              "name": "Unit 1: Perspectives in Education (PIE) & RTE Act 2009",
              "topics": [
                {
                  "id": "dsc-t1-pie",
                  "name": "History of Indian Education, National Education Policy (NEP 2020) & RTE 2009",
                  "subtopics": [
                    "Macaulay Minutes & Woods Despatch 1854",
                    "Kothari Commission (1964-66)",
                    "Right to Education Act 2009 Provisions",
                    "NEP 2020 Structure (5+3+3+4)"
                  ],
                  "hasTheory": true,
                  "hasPractice": true,
                  "theoryTitle": "Perspectives in Education: Commissions, RTE & NEP 2020",
                  "theorySummary": "Essential pedagogical theory and statutory provisions of Right to Education 2009 and teacher-student ratios for AP DSC.",
                  "theoryTables": [
                    {
                      "title": "Educational Commissions & Evolution of Educational Policy in India",
                      "headers": [
                        "Commission / Policy",
                        "Year & Chairman",
                        "Key Recommendation & Historical Significance"
                      ],
                      "rows": [
                        [
                          "Woods Despatch",
                          "1854 (Charles Wood)",
                          "Magna Carta of English Education in India; recommended universities at Calcutta, Bombay, Madras"
                        ],
                        [
                          "Hunter Commission",
                          "1882 (William Hunter)",
                          "Recommended bifurcation of secondary education into academic and vocational streams"
                        ],
                        [
                          "Radhakrishnan Commission",
                          "1948 (Dr. S. Radhakrishnan)",
                          "University Education Commission; led to creation of UGC in 1956"
                        ],
                        [
                          "Kothari Commission",
                          "1964-66 (D.S. Kothari)",
                          "Common School System; 10+2+3 pattern; 6% of National Income on Education"
                        ],
                        [
                          "RTE Act 2009 (Article 21A)",
                          "Enacted 2009 / Came into force 1 April 2010",
                          "Free & compulsory education for children aged 6 to 14 years; 25% reservation in private schools"
                        ],
                        [
                          "National Education Policy (NEP)",
                          "2020 (Dr. K. Kasturirangan)",
                          "Replaced 10+2 with 5+3+3+4 pedagogical structure; mother tongue instruction till Grade 5"
                        ]
                      ]
                    }
                  ],
                  "keyTakeaways": [
                    "Article 21A made elementary education a Fundamental Right via 86th Constitutional Amendment 2002.",
                    "Pupil-Teacher Ratio under RTE Act: 30:1 for primary and 35:1 for upper primary schools."
                  ]
                }
              ]
            },
