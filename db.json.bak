    {
      "id": "app-upsc-cse-em",
      "name": "UPSC Civil Services (IAS / IPS Prelims & Mains) - EM",
      "examCategory": "Central",
      "mediums": [
        "EM",
        "HM",
        "UM"
      ],
      "packageId": "in.upsc.cse.em",
      "isActive": true,
      "jurisdiction": "Central",
      "locale": "en",
      "themeColor": "amber",
      "accentColor": "#d97706",
      "currency": "INR",
      "currencySymbol": "₹",
      "bannerImage": "https://images.unsplash.com/photo-1524995997946-a1c2e315a42f?auto=format&fit=crop&w=1200&q=80",
      "syllabus": [
        {
          "id": "upsc-gs1",
          "name": "General Studies Paper I (Prelims & Mains)",
          "icon": "BookOpen",
          "units": [
            {
              "id": "upsc-u1-polity",
              "name": "Indian Polity, Governance & Constitutional Design",
              "topics": [
                {
                  "id": "upsc-t1-constitution",
                  "name": "Constitutional Philosophy, Fundamental Rights & Judicial Activism",
                  "subtopics": [
                    "Salient Features of the Indian Constitution",
                    "Writs Jurisprudence under Article 32 & 226",
                    "Federalism: Asymmetric Federalism & Emergency Powers",
                    "Judicial Review & Collegium System"
                  ],
                  "hasTheory": true,
                  "hasPractice": true,
                  "theoryTitle": "Constitutional Governance & Institutional Check-and-Balances",
                  "theorySummary": "Essential conceptual notes for UPSC CSE Prelims and GS Paper II Mains analyzing separation of powers, judicial appointments, and federal conflicts.",
                  "theoryContent": "### Constitutional Governance & Judicial Philosophy\n\nThe Constitution of India balances parliamentary sovereignty (British tradition) with judicial supremacy (American model).\n\n#### 1. Fundamental Rights vs Directive Principles\n* **Champakam Dorairajan (1951):** FRs superior to DPSPs.\n* **Minerva Mills (1980):** Indian Constitution is founded on the bedrock of the balance between Part III (FRs) and Part IV (DPSPs). Giving absolute primacy to one destroys harmony.\n\n#### 2. The Doctrine of Judicial Review\n* Implicit in **Article 13(2)**: Any law in derogation of Fundamental Rights is void.\n* Expansion into **Public Interest Litigation (PIL)** spearheaded by Justice P.N. Bhagwati and V.R. Krishna Iyer.",
                  "theoryTables": [
                    {
                      "title": "Key Constitutional Articles & Schedules for Competitive Exams",
                      "headers": [
                        "Article / Schedule",
                        "Constitutional Subject Matter",
                        "Key Examination Relevance"
                      ],
                      "rows": [
                        [
                          "Article 14 - 18",
                          "Right to Equality",
                          "Prohibition of discrimination (Art 15), Equality in public employment (Art 16), Abolition of Untouchability (Art 17)"
                        ],
                        [
                          "Article 19 - 22",
                          "Right to Freedom",
                          "Six fundamental freedoms (Art 19), Protection in respect of conviction (Art 20), Protection of Life & Personal Liberty (Art 21)"
                        ],
                        [
                          "Article 32",
                          "Right to Constitutional Remedies",
                          "Heart & Soul of Constitution (Dr. Ambedkar) - 5 Writs: Habeas Corpus, Mandamus, Prohibition, Certiorari, Quo-Warranto"
                        ],
                        [
                          "Article 40",
                          "Organisation of Village Panchayats",
                          "Directive Principles of State Policy - foundation for 73rd Constitutional Amendment Act 1992"
                        ],
                        [
                          "Article 324",
                          "Election Commission of India",
                          "Superintendence, direction & control of elections to Parliament, State Legislatures, President & Vice-President"
                        ],
                        [
                          "Schedule 7",
                          "Division of Powers",
                          "Union List (100 subjects), State List (61 subjects), Concurrent List (52 subjects)"
                        ],
                        [
                          "Schedule 11 & 12",
                          "Local Self Government",
                          "73rd Amendment (29 functional items for Panchayats) & 74th Amendment (18 items for Municipalities)"
                        ]
                      ]
                    }
                  ],
                  "keyTakeaways": [
                    "Article 368 does not confer power to abrogate the core principles of democracy or secularism.",
                    "Article 142 empowers the Supreme Court to pass any decree necessary for doing \"complete justice\"."
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
